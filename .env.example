# ============================================
# VidraERP - Template de Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha com seus valores reais
# Comando: cp .env.example .env
# Backend: Supabase

# --------------------------------------------
# CONFIGURAÇÃO DO SERVIDOR
# --------------------------------------------
NODE_ENV=development
PORT=3000
HOST=localhost

# --------------------------------------------
# SUPABASE
# --------------------------------------------
# Obtenha em: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=
# ⚠️ SOMENTE BACKEND! Nunca expor no frontend (sem prefixo VITE_)
# SERVICE_ROLE_KEY bypassa TODAS as políticas de RLS
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --------------------------------------------
# VITE - Variáveis Públicas (prefixo VITE_)
# --------------------------------------------
VITE_AUTH_PROVIDER=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DEFAULT_EMPRESA_ID=00000000-0000-0000-0000-000000000001
VITE_SITE_URL=http://localhost:3000

# --------------------------------------------
# E2E - Playwright (opcional)
# --------------------------------------------
E2E_SUPABASE_ENABLED=false
E2E_SUPABASE_EMAIL=
E2E_SUPABASE_PASSWORD=
E2E_BASE_URL=http://127.0.0.1:4173
